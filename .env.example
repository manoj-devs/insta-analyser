# Copy to .env (never commit .env). Real environment variables win over this file.
APP_ENV=development            # production = HTTPS-only cookies, HSTS, no on-screen/dev inbox fallback
SECRET_KEY=change-me-long-random
DATA_DIR=                      # production: a persistent disk, e.g. /var/data
OTP_CHANNELS=email             # email | sms | both
OTP_LOGIN=new_device           # new_device | always | never   (sign-up always needs a code)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=                     # e.g. a Gmail app password
SMTP_FROM=
TWILIO_ACCOUNT_SID=            # only for SMS
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- build 5.5 ---
PUBLIC_MODE=0                  # share_online.py sets this to 1 for you
ADMIN_ALLOWED_IPS=             # optional: 203.0.113.5,10.0.0.0/8  (empty = no limit)
ADMIN_PATH=                    # optional: secret address for the admin portal instead of /admin
NGROK_AUTHTOKEN=               # optional: use ngrok instead of Cloudflare Tunnel
SPONSORED_SHARE=0.20           # share of posts that are paid brand posts (earnings estimate)
GROWTH_PCT_MONTH=2.0           # follower growth per month used in projections
OTHER_STREAMS_PCT=12           # extra income (affiliate, product) as % of sponsored income
